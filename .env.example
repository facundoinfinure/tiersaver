# Copy to .env (never commit .env). Values are per environment (dev / prod).

# Shopify app (from the Dev Dashboard / `shopify app env show`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=

# 32-byte key (base64) used to encrypt Klaviyo and Shopify tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Klaviyo OAuth app (if OAuth is confirmed)
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_API_REVISION=2026-10-15

# Test Klaviyo account only: private key used by scripts/seed-klaviyo and integration tests.
KLAVIYO_TEST_PRIVATE_KEY=

# Shared secret for the job tick endpoint (cron → /jobs/tick)
JOBS_TICK_SECRET=
