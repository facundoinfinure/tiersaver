{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tiersaver-app",
  // TierSaver Cloudflare account (pinned so deploys never land in another account).
  "account_id": "6b463774c79fa154bac8b0b07ad049b1",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-12",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiersaver",
      "database_id": "d8082eef-a8c1-4941-99ec-ab010c9e1860",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SCOPES": "read_orders",
    "SHOPIFY_APP_URL": "https://tiersaver-app.tiersaver.workers.dev"
  }
}
