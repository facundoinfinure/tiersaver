{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tiersaver-app",
  // TierSaver Cloudflare account (pinned so deploys never land in another account).
  "account_id": "6b463774c79fa154bac8b0b07ad049b1",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-12",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiersaver",
      "database_id": "d8082eef-a8c1-4941-99ec-ab010c9e1860",
      "migrations_dir": "drizzle"
    }
  ],
  "workflows": [
    {
      // Suppression and undo runs. One step per batch of up to 100 profiles.
      "name": "tiersaver-suppression-run",
      "binding": "SUPPRESSION_RUN",
      "class_name": "SuppressionRunWorkflow"
    },
    {
      // Audit + simulation scans (read-only apart from the one managed segment). See app/scans/engine.ts.
      "name": "tiersaver-scan",
      "binding": "SCAN",
      "class_name": "ScanWorkflow"
    },
    {
      // One-time read of a shop's order history into hashed buyers, one page per step.
      "name": "tiersaver-orders-backfill",
      "binding": "ORDERS_BACKFILL",
      "class_name": "OrdersBackfillWorkflow"
    }
  ],
  // Not set here on purpose:
  // - SUPPRESSION_ENABLED: safety switch read by app/runs/gateway.server.ts. While it is absent (or anything
  //   other than "true") every suppression batch is refused with "suppression_disabled" and no
  //   merchant's Klaviyo account is touched. Only the owner turns it on, as a var or with `wrangler secret put`.
  // - Secrets (`wrangler secret put`): SHOPIFY_API_KEY, SHOPIFY_API_SECRET, TOKEN_ENCRYPTION_KEY,
  //   KLAVIYO_CLIENT_ID, KLAVIYO_CLIENT_SECRET. Declared in app/secrets.d.ts.
  "vars": {
    "SCOPES": "read_orders",
    // Id of the Klaviyo TEST account filled by scripts/seed-klaviyo. A scan reads seeded data (API-owned
    // metrics, intended profile age from a profile property) only for a connection to exactly this
    // account that Klaviyo also flags as a test account. It has no effect on any other account.
    "KLAVIYO_SEEDED_ACCOUNT_ID": "SGKvLG",
    "SHOPIFY_APP_URL": "https://tiersaver-app.tiersaver.workers.dev"
  }
}
